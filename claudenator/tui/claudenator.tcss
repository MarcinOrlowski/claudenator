/* Every colour is a theme variable. Never a literal one, so every theme fits. */

Screen {
    layout: vertical;
}

/* The top line: every view by name on the left, the tool and its version on
   the right. The view switch lives here because a view holds the whole screen,
   so the footer keeps its room for the keys of the row and of the tool. */
#title-bar {
    height: 1;
    background: $panel;
    color: $foreground;
}

.view-name {
    width: auto;
    padding: 0 1;
    color: $text-muted;
    text-wrap: nowrap;
}

/* The view on screen. The pair is the one a list gives the row under its
   cursor, so the name reads in every theme. */
.view-name.-on {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: bold;
}

.view-name:hover {
    background: $block-hover-background;
}

/* The room between the view names and the tool. */
#title-gap {
    width: 1fr;
}

#brand {
    width: auto;
    padding: 0 0 0 1;
}

/* The 'about' key, at the right of the brand. The colour is the one the footer
   gives its own keys, so a key reads the same in both places. */
#about-key {
    width: auto;
    padding: 0 1;
    color: $footer-key-foreground;
    text-style: bold;
}

#body {
    height: 1fr;
}

/* A window too narrow for two columns holds the panes in one, so that every
   pane keeps the full width. The width that does this comes from settings. */
#body.-stacked {
    layout: vertical;
}

/* The width, or the height in one column, comes from settings */
#left {
    height: 1fr;
}

#right {
    width: 1fr;
    height: 1fr;
}

ProjectsPane, SessionsPane, DetailsPane, DaysPane, EntriesPane, EntryPane, FilterBox {
    background: $surface;
    border: round $border-blurred;
    border-title-color: $text-muted;
}

/* The keys of the pane itself sit on the bottom-right of its own frame. Only
   the pane with the focus answers them, so only it shows them. The words take
   the plain colour of text; every key carries the colour the footer gives a
   key, so the key alone catches the eye. See ``KEY_STYLE``. */
ProjectsPane:focus, SessionsPane:focus, DetailsPane:focus,
DaysPane:focus, EntriesPane:focus, EntryPane:focus, FilterBox:focus {
    border: round $border;
    border-title-color: $text;
    border-subtitle-color: $text;
    border-subtitle-align: right;
}

ProjectsPane, DaysPane {
    width: 1fr;
    height: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

SessionsPane, EntriesPane {
    height: 1fr;
}

/* A session row takes its colour from its state. A row holds one colour only,
   so a damaged session comes before a live one, and a live one before a fork.
   The State column says the same in letters, so a colour-blind eye and a
   screen with no colour lose nothing. The row under the cursor keeps the
   colours of the cursor, so it stays easy to read in every theme. */
SessionsPane > .sessions--damaged {
    color: $text-error;
}

SessionsPane > .sessions--live {
    color: $text-success;
}

/* Not $text-muted, which the two ANSI themes leave as the plain colour, and
   not $text-secondary, which monokai makes the same as $text-error. This one
   is a colour of its own in all 20 themes. */
SessionsPane > .sessions--fork {
    color: $text-primary;
}

DetailsPane, EntryPane {
    height: auto;
    max-height: 50%;
    padding: 0 1;
}

/* The pane cuts a long line itself. This is the net under it: no wrap, ever. */
DetailsPane Static, EntryPane Static {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

FilterBox {
    width: 1fr;
    height: 3;
    padding: 0 1;
}

/* The keys of the whole tool, at the right edge of the footer, away from the
   keys of the pane. The library docks its own command-palette key this way. */
#tool-keys {
    dock: right;
    width: auto;
    height: 1;
}

/* The window has no room for the panes. This message takes their place. */
#too-small {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    text-align: center;
}

/* One session or one entry in full, over the whole window. */
#full {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    background: $surface;
    border: round $border;
    border-title-color: $text;
}

#full Static {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The About box sits in the middle of the window, over the panes. */
AboutScreen {
    align: center middle;
}

/* As wide and as tall as its lines, but never past the window: a small
   window scrolls the box instead of breaking the QR code. */
#about {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    padding: 0 1;
    background: $surface;
    border: round $border;
    border-title-color: $text;
}

/* The tool at the left, its keys at the right: two short columns keep the box
   inside a window of 80 by 24. */
#about-columns {
    width: auto;
    height: auto;
}

#about-text {
    width: auto;
    text-align: center;
    text-wrap: nowrap;
}

#about-keys {
    width: auto;
    margin: 0 0 0 2;
    text-wrap: nowrap;
}

/* The question before a session goes to the Trash, or an entry off the disk. */
ConfirmScreen {
    align: center middle;
}

#confirm {
    width: 60;
    height: auto;
    max-width: 100%;
    padding: 1 1 0 1;
    background: $surface;
    border: round $border;
    border-title-color: $text;
}

/* The thing the question is about. It never wraps */
#confirm-subject {
    width: 1fr;
    padding: 1 0;
    color: $text-accent;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#confirm-buttons {
    height: 3;
    width: 1fr;
    align: right middle;
}

#confirm-buttons Button {
    min-width: 8;
    margin: 0 0 0 1;
}

SettingsScreen {
    align: center middle;
}

#settings {
    width: 68;
    height: 17;
    max-width: 100%;
    max-height: 100%;
    background: $surface;
    border: round $border;
    border-title-color: $text;
}

/* The sections take the room the buttons leave. */
#settings > TabbedContent {
    height: 1fr;
}

/* The options of one section. */
.option-page {
    height: 1fr;
    padding: 0 1;
}

.option-row {
    height: 3;
    width: 1fr;
}

/* A switch is as wide as a switch. */
.option-row Switch {
    width: auto;
}

/* As wide as the longest name. */
.option-label {
    width: 26;
    height: 3;
    content-align: left middle;
}

.option-value {
    width: 1fr;
}

#settings-buttons {
    dock: bottom;
    height: 3;
    width: 1fr;
    padding: 0 1;
}

#settings-buttons Button {
    min-width: 8;
    margin: 0 0 0 1;
}

.button-gap {
    width: 1fr;
}
